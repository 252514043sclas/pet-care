# Pet Care API Configuration
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database Settings (XAMPP default: host=127.0.0.1, user=root, password="")
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pet_care_db
DB_USER=root
DB_PASS=

# JWT / Auth Token Expiry (in days)
TOKEN_EXPIRY_DAYS=30

